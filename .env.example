# Copy this file to .env and fill in your own values. Never commit .env.
# Supabase: Project Settings -> API (or "API Keys")
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable / anon key: read-only, used by the dashboard
SUPABASE_KEY=your-publishable-or-anon-key
# Secret / service_role key: used only by scripts/load_supabase.py to write rows
SUPABASE_SECRET_KEY=your-secret-or-service-role-key
